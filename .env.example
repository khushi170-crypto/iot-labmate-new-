# Copy to .env and fill in values.
# Prisma: SQLite connection string (dev) or your Postgres URL (prod)
DATABASE_URL="file:./dev.db"

# Auth - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# AI Kit Builder
# rule-based => deterministic keyword mapper (works offline, no key needed)
# llm        => real LLM integration (requires LLM_API_KEY)
AI_PROVIDER="rule-based"
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"
LLM_BASE_URL="https://api.openai.com/v1"

# App configuration (editable from the Lab Assistant settings page)
FINE_RATE_PER_DAY="10"
LOAN_PERIOD_DAYS="7"
CURRENCY="$"

# Signup invite code required to register a Lab Assistant. Leave empty to disable assistant signup.
ASSISTANT_SIGNUP_CODE="LAB2026"

# Online fine payments (Razorpay, TEST MODE).
# 1. Open https://dashboard.razorpay.com/app/keys while the dashboard is in Test Mode.
# 2. Click "Generate Test Key" and copy the Key ID (rzp_test_...) and Key Secret.
# 3. Paste them below, then restart `npm run dev`.
# These are server-only secrets — never expose RAZORPAY_KEY_SECRET to the browser or commit it.
# Leave both empty to disable online payment and keep the manual Collect/Waive flow.
RAZORPAY_KEY_ID="rzp_test_ToGVFXWr3xECFv"
RAZORPAY_KEY_SECRET="mbgRDiXBcLF79NrTGp6d7yCj"
# Currency sent to Razorpay for the charge (Razorpay test mode settles INR).
RAZORPAY_CURRENCY="INR"
